# Copy to .env. Never commit real secrets.
LOOPR_ENV=development
LOOPR_DATABASE_URL=sqlite:///./loopr.db
# Production: postgresql+psycopg://user:pass@host:5432/loopr
LOOPR_JWT_SECRET=change-me
LOOPR_OTP_PROVIDER=mock
LOOPR_RAZORPAY_KEY_ID=
LOOPR_RAZORPAY_KEY_SECRET=
LOOPR_RAZORPAY_WEBHOOK_SECRET=change-me-webhook
